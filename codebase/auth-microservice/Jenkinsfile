pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        ECR_URI = '767397915565.dkr.ecr.us-east-1.amazonaws.com/test'
        IMAGE_NAME = 'test'
    }

    stages {
        stage('Prepare Tag') {
            steps {
                script {
                    // Try to use Git commit SHA if available, fallback to Jenkins build number
                    def gitCommit = sh(script: "git rev-parse --short HEAD || echo ${env.BUILD_NUMBER}", returnStdout: true).trim()
                    env.IMAGE_TAG = gitCommit
                    env.FULL_IMAGE_URI = "${ECR_URI}:${env.IMAGE_TAG}"
                    echo "Using image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region $AWS_REGION | \
                    docker login --username AWS --password-stdin $ECR_URI
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME:$IMAGE_TAG ./codebase/auth-microservice/'
            }
        }

        stage('Tag Docker Image') {
            steps {
                sh 'docker tag $IMAGE_NAME:$IMAGE_TAG $FULL_IMAGE_URI'
            }
        }

        stage('Push to ECR') {
            steps {
                sh 'docker push $FULL_IMAGE_URI'
            }
        }
    }

    post {
        success {
            echo '✅ Docker image pushed successfully!'
        }
        failure {
            echo '❌ Build or push failed!'
        }
    }
}
